      "panel-5": {
        "kind": "Panel",
        "spec": {
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "InfluxDB"
                      },
                      "group": "influxdb",
                      "kind": "DataQuery",
                      "spec": {
                        "query": "income_reg = from(bucket: \"palmo_ledger\")\r\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\r\n  |> filter(fn: (r) => r[\"_measurement\"] == \"registrations\")\r\n  |> filter(fn: (r) => r[\"_field\"] == \"initialBalance\")\r\n  |> keep(columns: [\"_time\", \"_value\"])\r\n\r\nincome_top = from(bucket: \"palmo_ledger\")\r\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\r\n  |> filter(fn: (r) => r[\"_measurement\"] == \"topups\")\r\n  |> filter(fn: (r) => r[\"_field\"] == \"amount\")\r\n  |> keep(columns: [\"_time\", \"_value\"])\r\n\r\nexpense = from(bucket: \"palmo_ledger\")\r\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\r\n  |> filter(fn: (r) => r[\"_measurement\"] == \"transactions\")\r\n  |> filter(fn: (r) => r[\"status\"] == \"APPROVED\")\r\n  |> filter(fn: (r) => r[\"_field\"] == \"amount\")\r\n  |> keep(columns: [\"_time\", \"_value\"])\r\n  |> map(fn: (r) => ({ r with _value: -r._value }))\r\n\r\nunion(tables: [income_reg, income_top, expense])\r\n  |> sort(columns: [\"_time\"])\r\n  |> cumulativeSum(columns: [\"_value\"])\r\n  |> aggregateWindow(every: v.windowPeriod, fn: last, createEmpty: false)\r\n  |> set(key: \"_field\", value: \"Total balance EUR\")"
                      },
                      "version": "v0"
                    },
                    "refId": "A"
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
